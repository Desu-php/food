# Local development only. Replace this password for real deployments.
POSTGRES_USER=catalog
POSTGRES_PASSWORD=catalog_local_password
POSTGRES_DB=catalog
POSTGRES_PORT=5432
CATALOG_PORT=8080
LOG_LEVEL=INFO
HTTP_ADDR=:8080
DATABASE_URL=postgres://catalog_service:catalog_service_local_password@localhost:5432/catalog?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_CONNECT_TIMEOUT=5s
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=5m
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
REQUEST_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s

# Separate service roles. Use URL-safe values here (or percent-encode URL passwords).
CATALOG_DB_PASSWORD=catalog_service_local_password
ORDERS_DB_PASSWORD=orders_service_local_password
ORDERS_PORT=8081
CATALOG_BASE_URL=http://localhost:8082
CATALOG_TIMEOUT=2s
INTERNAL_HTTP_ADDR=127.0.0.1:8082
ORDERS_DATABASE_URL=postgres://orders_service:orders_service_local_password@localhost:5432/orders?sslmode=disable
# Local development only. Production requires OIDC and DEV_AUTH_ENABLED=false.
APP_ENV=development
DEV_AUTH_ENABLED=true

# Notifications owns an independent PostgreSQL instance.
NOTIFICATIONS_POSTGRES_PASSWORD=notifications_admin_local_password
NOTIFICATIONS_DB_PASSWORD=notifications_service_local_password
NOTIFICATIONS_DB_PORT=5433
NOTIFICATIONS_PORT=8083
NOTIFICATIONS_DATABASE_URL=postgres://notifications_service:notifications_service_local_password@localhost:5433/notifications?sslmode=disable

REDPANDA_IMAGE=docker.redpanda.com/redpandadata/redpanda:v26.2.5
REDPANDA_SMP=1
REDPANDA_MEMORY=512M
KAFKA_EXTERNAL_HOST=localhost
KAFKA_EXTERNAL_PORT=19092
KAFKA_INTERNAL_BROKERS=redpanda:9092
# Native Go processes use the external listener; containers use the internal one.
KAFKA_BROKERS=localhost:19092
ORDERS_EVENTS_TOPIC=orders.events.v1
ORDERS_EVENTS_PARTITIONS=3
ORDERS_EVENTS_REPLICAS=1
ORDERS_EVENTS_RETENTION_MS=604800000
KAFKA_CONSUMER_GROUP=notifications-v1
KAFKA_PUBLISH_TIMEOUT=10s
DB_OPERATION_TIMEOUT=5s
OUTBOX_HTTP_ADDR=:8084
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_LEASE=30s
OUTBOX_RETRY_BASE=1s
OUTBOX_RETRY_MAX=5m
OUTBOX_MAX_ATTEMPTS=20
OUTBOX_RETENTION=168h
OUTBOX_CLEANUP_INTERVAL=1h
CONSUMER_RETRY_BASE=1s
CONSUMER_RETRY_MAX=10s
CONSUMER_MAX_ATTEMPTS=5

# Operational POS collection; no bank integration.
DELIVERY_DB_PASSWORD=delivery_service_local_password
DELIVERY_DATABASE_URL=postgres://delivery_service:delivery_service_local_password@localhost:5432/delivery?sslmode=disable
DELIVERY_PORT=8085
DELIVERY_EVENTS_TOPIC=delivery.events.v1
# Explicit local-only grants: user 10 manages restaurant 1; user 20 dispatches.
DEV_RESTAURANT_GRANTS=10:1
DEV_DISPATCHER_IDS=20

# Persisted fulfillment orchestration; no automatic courier selection.
DELIVERY_COMMANDS_TOPIC=delivery.commands.v1
SAGA_CREATE_TIMEOUT=5m
SAGA_ASSIGNMENT_TIMEOUT=10m
SAGA_PROGRESS_TIMEOUT=30m
SAGA_CANCEL_TIMEOUT=5m
SAGA_RETRY_BASE=1s
SAGA_RETRY_MAX=30s
SAGA_MAX_ATTEMPTS=20
SAGA_POLL_INTERVAL=1s
SAGA_CANCEL_BEFORE_PREPARING=false

# Catalog administration is opt-in even in local development.
DEV_ADMIN_IDS=1
# Trusted issuer/JWKS endpoints (HTTPS). OIDC and dev authentication are exclusive.
OIDC_ISSUER=
OIDC_JWKS_URL=
# MVP SPA: set OIDC_AUDIENCE=food-api for every public API. Never use the SPA client ID.
# Per-service overrides remain available for deployments using resource tokens.
CATALOG_OIDC_AUDIENCE=
ORDERS_OIDC_AUDIENCE=
DELIVERY_OIDC_AUDIENCE=
# Native processes use OIDC_AUDIENCE; Compose falls back to it if override is empty.
OIDC_AUDIENCE=
# Server-owned registry path; mount read-only in containers with an override file.
AUTH_IDENTITIES_FILE=
# Exact comma-separated SPA origins (no slash/wildcard); empty disables CORS.
# Example for development: http://localhost:9000. Production requires HTTPS.
CORS_ALLOWED_ORIGINS=

# Optional local HTTPS Keycloak overlay (see docs/auth-profile-oidc.md).
# COMPOSE_FILE=deploy/compose.yaml:deploy/compose.oidc.yaml
# KEYCLOAK_PUBLIC_URL=https://localhost:8443
# KEYCLOAK_ADMIN_USER=local-admin
# KEYCLOAK_ADMIN_PASSWORD=<generate-a-local-password>

# Automatic dispatch: Redis is ephemeral and optional for manual operations.
REDIS_URL=redis://redis:6379/0
DISPATCH_ENABLED=true
DISPATCH_RADIUS_METERS=5000
DISPATCH_POLL_INTERVAL=1s
DISPATCH_LEASE=15s
DISPATCH_OPERATION_TIMEOUT=3s
DISPATCH_RETRY_INTERVAL=5s
DISPATCH_MAX_ATTEMPTS=60
DISPATCH_COOLDOWN=2m
LOCATION_TTL=60s
LOCATION_MIN_INTERVAL=5s

# Real-time customer tracking (Delivery API)
LOCATION_MAX_ACCURACY_METERS=100
TRACKING_POLL_INTERVAL=2s
TRACKING_HEARTBEAT=15s
TRACKING_MAX_DURATION=5m
TRACKING_WRITE_TIMEOUT=5s
TRACKING_OPERATION_TIMEOUT=2s
TRACKING_MAX_CONNECTIONS=200
TRACKING_MAX_PER_CUSTOMER=3

# Stage 14: fake is explicitly restricted to development/test.
NOTIFICATIONS_OIDC_AUDIENCE=
PUSH_PROVIDER=fake
FIREBASE_PROJECT_ID=
# Local-only service credential. Generate an independent random value in production.
PUSH_RELEVANCE_KEY=local-only-push-relevance-key-change-in-production
DELIVERY_INTERNAL_URL=http://localhost:8085
PUSH_TIMEOUT=10s
PUSH_LEASE=45s
PUSH_POLL_INTERVAL=250ms
PUSH_RETRY_BASE=1m
PUSH_RETRY_MAX=1h
PUSH_MAX_ATTEMPTS=8
PUSH_SEND_INTERVAL=100ms
DEVICE_STALE_AFTER=720h
DEVICE_CLEANUP_INTERVAL=1h

# Stage 18: opt-in independent Auth. Do not combine auth and oidc overlays.
# Generate fresh passwords and key files; see docs/auth-service.md.
AUTH_POSTGRES_PASSWORD=
AUTH_DB_PASSWORD=
AUTH_ISSUER=http://localhost:8084
AUTH_AUDIENCE=food-api
AUTH_ACTIVE_KID=initial
AUTH_ACCESS_TTL=3m
AUTH_SESSION_TTL=720h
AUTH_COOKIE_SECURE=true
AUTH_ALLOW_UNVERIFIED_LOGIN=false
AUTH_ARGON_MEMORY_KIB=19456
AUTH_ARGON_ITERATIONS=2
AUTH_ARGON_PARALLELISM=1
AUTH_HASH_CONCURRENCY=2
# Native: AUTH_PRINCIPAL_URL, AUTH_SERVICE_KEY_FILE, AUTH_SIGNING_KEYS_FILE,
# AUTH_CSRF_KEY_FILE. Compose auth overlay mounts files from .local/auth/.
